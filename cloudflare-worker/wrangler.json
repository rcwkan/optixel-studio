{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "makecade-optixel-router",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "routes": [
    {
      "pattern": "optixel.makecade.com/*",
      "zone_name": "makecade.com"
    }
  ],
  "vars": {
    "PAGES_ORIGIN": "https://optixel-studio.pages.dev",
    "CUSTOM_DOMAIN": "https://optixel.makecade.com"
  }
}
