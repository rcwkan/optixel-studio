{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Optixel Studio",
  "version": "0.3.0",
  "identifier": "org.optixel.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Optixel Studio",
        "width": 1480,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self';",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3RjQyNjg4MzIyREI5N0EKUlVSNndHUkZRNnFpNDQxd1Z4Nm5sR1d0NWtiYVdHQnN0L0t1MGFvdDJKWGZCM1pnSTc0OGtBNjUK",
      "endpoints": [
        "https://updates.optixel.studio/v1/update/{{target}}/{{current_version}}",
        "https://optixel-studio-updates.workers.dev/v1/update/{{target}}/{{current_version}}"
      ]
    }
  },
  "mainBinaryName": "optixel-studio"
}
